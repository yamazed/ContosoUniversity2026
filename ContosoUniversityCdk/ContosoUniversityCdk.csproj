<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Amazon.CDK.Lib" Version="2.227.0" />
    <PackageReference Include="Constructs" Version="10.4.3" />
  </ItemGroup>

  <ItemGroup>
    <!-- Exclude cdk.out directory from compilation to avoid errors from cached Docker asset builds -->
    <Compile Remove="cdk.out/**" />
    <EmbeddedResource Remove="cdk.out/**" />
    <None Remove="cdk.out/**" />
  </ItemGroup>

</Project>
